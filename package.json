{
  "name": "ai-tour-guide",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "expo": "~58.0.23",
    "expo-audio": "~58.0.11",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "^1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"supabase/**/*.ts\"",
    "content:validate": "tsx scripts/content/validate.ts",
    "content:seed-sql": "tsx scripts/content/build-seed-sql.ts",
    "content:import": "tsx scripts/content/import-wikidata.ts",
    "content:stories": "tsx scripts/content/generate-stories.ts",
    "content:review": "tsx scripts/content/review.ts",
    "eval:scan": "tsx scripts/eval-scan.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.maestro/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
